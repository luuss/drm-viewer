# --- Anwendung ---
CONVEX_URL=https://api.example.de
CONVEX_SITE_URL=https://hooks.example.de
VITE_CONVEX_URL=https://api.example.de
WORKER_POLL_SECONDS=5
WORKER_IDLE_POLL_MAX_SECONDS=60
VITE_TILE_SERVICE_URL=https://tiles.example.de
# Nur noetig, wenn die App unter einem Unterpfad laeuft (z.B. /digital/)
VITE_BASE_PATH=/

# --- Dienst-Geheimnisse, getrennt je Dienst ---
TILE_SERVICE_SECRET=<openssl rand -hex 32>
EXTRACT_SERVICE_SECRET=<openssl rand -hex 32>
SHOP_WEBHOOK_SECRET=<openssl rand -hex 32>

# --- Medienspeicher (MinIO/S3); ohne diese Werte nutzt der Worker die Convex-Ablage ---
MEDIA_BUCKET=emag-media
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=convexminio
AWS_SECRET_ACCESS_KEY=<geheim>
AWS_REGION=us-east-1

# --- Aufbereitung ---
PAGE_RENDER_WIDTH=2400
EXTRACT_USE_LLM=false
EXTRACT_LLM_PROVIDER=anthropic
# Kein implizites Modell: vor Aktivierung bewusst ein Vision-Modell waehlen.
EXTRACT_LLM_MODEL=
EXTRACT_LLM_API_KEY=
# Optional: eigener kompatibler Endpunkt; leer nutzt den Anbieter-Standard.
EXTRACT_LLM_BASE_URL=
# OpenRouter-Routing (nur relevant bei EXTRACT_LLM_PROVIDER=openrouter)
EXTRACT_LLM_ROUTING_ONLY=
EXTRACT_LLM_ZDR=true
EXTRACT_LLM_DATA_COLLECTION=deny
EXTRACT_LLM_ALLOW_FALLBACKS=false

# --- Missbrauchsbremse ---
CORS_ORIGINS=https://digital.example.de
MAX_PAGES_PER_MIN=80
MAX_TILES_PER_MIN=1200

# Diese Werte gehoeren in die Convex-Umgebung (npx convex env set ...):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#   RESEND_API_KEY, RESEND_FROM_EMAIL
#   APP_PUBLIC_URL, ADMIN_EMAILS (nur Erstzugang)
#   TILE_SERVICE_SECRET, EXTRACT_SERVICE_SECRET, SHOP_WEBHOOK_SECRET
#   MAX_ACTIVE_SESSIONS (Standard 2)
#   SUBSCRIPTION_GRACE_MS (Standard 3 Tage)
#   REQUIRE_EMAIL_VERIFICATION (true/false)
