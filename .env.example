# --- Convex ---
CONVEX_URL=https://<deployment>.convex.cloud
VITE_CONVEX_URL=https://<deployment>.convex.cloud

# --- Gemeinsames Geheimnis fuer Kachel- und Extraktionsdienst ---
TILE_SERVICE_SECRET=<openssl rand -hex 32>

# --- URLs, die der Browser anspricht ---
VITE_TILE_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- Extraktionsdienst (Artikel aus IDML/PDF) ---
EXTRACT_SERVICE_URL=http://localhost:8100
ANTHROPIC_API_KEY=            # optional: KI-Gruppierung beim PDF-Import
EXTRACT_LLM_MODEL=claude-sonnet-5

# --- Missbrauchsbremse ---
MAX_PAGES_PER_MIN=40
MAX_TILES_PER_MIN=900

# Diese Werte gehoeren in die Convex-Umgebung (npx convex env set ...):
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
#   RESEND_API_KEY, RESEND_FROM_EMAIL
#   APP_PUBLIC_URL, ADMIN_EMAILS
#   TILE_SERVICE_SECRET, EXTRACT_SERVICE_URL
#   MAX_ACTIVE_SESSIONS (Standard 3)
#   REQUIRE_EMAIL_VERIFICATION (true/false)
