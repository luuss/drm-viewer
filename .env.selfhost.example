# Beispielwerte fuer den selbst betriebenen Aufbau.
# Kopieren nach .env.selfhost und Geheimnisse ersetzen.

POSTGRES_PASSWORD=bitte-ersetzen
MINIO_ROOT_USER=convexminio
MINIO_ROOT_PASSWORD=bitte-ersetzen
# Schluessel fuer die serverseitige Verschluesselung in MinIO.
# Erzeugen mit: echo "emagazin-key:$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=emagazin-key:bitte-ersetzen
# Ports des Medienspeichers auf dem Wirt.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

CONVEX_INSTANCE_NAME=emagazin
CONVEX_INSTANCE_SECRET=bitte-ersetzen
CONVEX_CLOUD_ORIGIN=https://api.lesenundschenken.de
CONVEX_SITE_ORIGIN=https://hooks.lesenundschenken.de

WEB_DOMAIN=digital.lesenundschenken.de
API_DOMAIN=api.lesenundschenken.de
HOOKS_DOMAIN=hooks.lesenundschenken.de
TILE_DOMAIN=tiles.lesenundschenken.de
PUBLIC_WEB_ORIGIN=https://digital.lesenundschenken.de
PUBLIC_TILE_ORIGIN=https://tiles.lesenundschenken.de

TILE_SERVICE_SECRET=bitte-ersetzen
EXTRACT_SERVICE_SECRET=bitte-ersetzen
MEDIA_BUCKET=emag-media
PAGE_RENDER_WIDTH=2400
