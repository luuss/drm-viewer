# In Dokploy unter Compose -> Environment einfuegen. Keine echte .env-Datei
# und keine Geheimnisse ins Repository committen.
#
# Seit dem Umzug laeuft Convex im selben Stapel. Es gibt keine Convex-Cloud
# mehr, keinen Deploy-Key und keine *.convex.cloud-Adresse.

# --- Oeffentliche Adressen (muessen als Domains in Dokploy angelegt sein) ---
PUBLIC_WEB_ORIGIN=https://d.chuk.dev
CONVEX_CLOUD_ORIGIN=https://api.d.chuk.dev
CONVEX_SITE_ORIGIN=https://hooks.d.chuk.dev
PUBLIC_MEDIA_ORIGIN=https://medien.d.chuk.dev

# --- Convex ---
# Der Name bestimmt auch den Namen der Datenbank. Aendern heisst: leer starten.
CONVEX_INSTANCE_NAME=emagazin
# openssl rand -hex 32 — aus ihm leitet sich der Admin-Schluessel ab.
# Wird er geaendert, gilt jeder bisherige Admin-Schluessel nicht mehr.
CONVEX_INSTANCE_SECRET=<openssl rand -hex 32>

# --- Datenbank und Medienspeicher ---
POSTGRES_PASSWORD=<openssl rand -hex 24>
MINIO_ROOT_USER=convexminio
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
# Ohne diesen Wert lehnt MinIO jeden Upload mit "KMS not configured" ab.
MINIO_KMS_SECRET_KEY=eigen:<openssl rand -base64 32>
MEDIA_BUCKET=emag-media

# --- Dienstgeheimnisse ---
# Dieselben Werte gehoeren als GitHub-Secrets hinterlegt; der Workflow setzt
# sie damit im Convex-Backend. Stimmen sie nicht ueberein, weist das Backend
# Kacheldienst und Import-Worker ab.
TILE_SERVICE_SECRET=<openssl rand -hex 32>
EXTRACT_SERVICE_SECRET=<openssl rand -hex 32>

# --- Stellschrauben ---
MAX_PAGES_PER_MIN=80
MAX_TILES_PER_MIN=1200
PAGE_RENDER_WIDTH=2400
WORKER_POLL_SECONDS=5
WORKER_IDLE_POLL_MAX_SECONDS=60
