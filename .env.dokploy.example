# In Dokploy unter Compose -> Environment einfuegen. Keine echte .env-Datei
# und keine Secrets ins Repository committen.

PUBLIC_WEB_ORIGIN=https://d.chuk.dev
VITE_CONVEX_URL=https://doting-meadowlark-384.eu-west-1.convex.cloud
CONVEX_SITE_URL=https://doting-meadowlark-384.eu-west-1.convex.site

# Muessen mit den gleichnamigen Convex-Umgebungswerten uebereinstimmen.
TILE_SERVICE_SECRET=<openssl rand -hex 32>
EXTRACT_SERVICE_SECRET=<openssl rand -hex 32>

MAX_PAGES_PER_MIN=80
MAX_TILES_PER_MIN=1200
PAGE_RENDER_WIDTH=2400
WORKER_POLL_SECONDS=5
WORKER_IDLE_POLL_MAX_SECONDS=60

# Optionale KI-Nachbearbeitung
EXTRACT_USE_LLM=false
EXTRACT_LLM_PROVIDER=openrouter
EXTRACT_LLM_MODEL=deepseek/deepseek-v4.1-flash
EXTRACT_LLM_API_KEY=
EXTRACT_LLM_BASE_URL=https://openrouter.ai/api/v1
EXTRACT_LLM_ROUTING_ONLY=
EXTRACT_LLM_ZDR=true
EXTRACT_LLM_DATA_COLLECTION=deny
EXTRACT_LLM_ALLOW_FALLBACKS=false
